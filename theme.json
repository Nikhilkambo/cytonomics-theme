{
    "version": 2,
    "settings": {
        "appearanceTools": true,
        "border": {
            "color": true,
            "radius": true,
            "style": true,
            "width": true
        },
        "color": {
            "background": true,
            "custom": true,
            "customDuotone": true,
            "customGradient": true,
            "defaultGradients": true,
            "defaultPalette": true,
            "duotone": [
                {
                    "colors": [ "#000000", "#ffffff" ],
                    "name": "Black and white",
                    "slug": "black-and-white"
                }
            ],
            "gradients": [
                {
                    "name": "Primary to Secondary",
                    "gradient": "linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%)",
                    "slug": "primary-to-secondary"
                }
            ],
            "link": true,
            "palette": [
                {
                    "name": "Primary",
                    "slug": "primary",
                    "color": "var(--primary-color)"
                },
                {
                    "name": "Secondary",
                    "slug": "secondary",
                    "color": "var(--secondary-color)"
                },
                {
                    "name": "Text",
                    "slug": "text",
                    "color": "var(--text-color)"
                },
                {
                    "name": "Background",
                    "slug": "background",
                    "color": "var(--background-color)"
                }
            ],
            "text": true
        },
        "custom": {
            "spacing": {
                "padding": true,
                "margin": true
            },
            "typography": {
                "fontSize": true,
                "lineHeight": true
            }
        },
        "layout": {
            "contentSize": "1200px",
            "wideSize": "1400px"
        },
        "spacing": {
            "blockGap": true,
            "margin": true,
            "padding": true,
            "units": [ "px", "em", "rem", "vh", "vw" ]
        },
        "typography": {
            "customFontSize": true,
            "dropCap": true,
            "fontFamilies": [
                {
                    "fontFamily": "-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Helvetica Neue', sans-serif",
                    "name": "System Font",
                    "slug": "system-font"
                }
            ],
            "fontSizes": [
                {
                    "name": "Small",
                    "size": "0.875rem",
                    "slug": "small"
                },
                {
                    "name": "Normal",
                    "size": "1rem",
                    "slug": "normal"
                },
                {
                    "name": "Large",
                    "size": "1.25rem",
                    "slug": "large"
                },
                {
                    "name": "Extra Large",
                    "size": "1.5rem",
                    "slug": "extra-large"
                }
            ],
            "fontStyle": true,
            "fontWeight": true,
            "letterSpacing": true,
            "lineHeight": true,
            "textDecoration": true,
            "textTransform": true
        }
    },
    "styles": {
        "color": {
            "background": "var(--background-color)",
            "text": "var(--text-color)"
        },
        "typography": {
            "fontFamily": "var(--wp--preset--font-family--system-font)",
            "fontSize": "var(--wp--preset--font-size--normal)"
        }
    },
    "templateParts": [
        {
            "name": "header",
            "title": "Header",
            "area": "header"
        },
        {
            "name": "footer",
            "title": "Footer",
            "area": "footer"
        }
    ]
} 